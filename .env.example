# Copy to .env.local and fill in. Never commit real keys.

# --- Jev -------------------------------------------------------------------

# Jev structured decision endpoint.
JEV_API_URL=https://www.jevai.org/api/v1/decisions

# Jev API key, sent server-side as `Authorization: Bearer <key>`. Required.
# For the GitHub Action, add it as the repository secret JEV_API_KEY instead.
JEV_API_KEY=

# Request timeout in milliseconds (default 30000).
JEV_TIMEOUT_MS=30000

# "true" returns Jev's documented example response instead of calling the API
# (offline demos). Either way, the unmodified demo PR falls back to that example
# if Jev is unavailable. The UI labels these results.
JEV_USE_SAMPLE_RESPONSE=false

# --- Real GitHub PR reviews (dashboard "Live PRs" mode) ----------------------

# The repository whose PRs the dashboard shows. Only this repository can be queried.
# GITHUB_REPOSITORY may also be given as "owner/name".
GITHUB_OWNER=
GITHUB_REPOSITORY=

# Read-only GitHub token for the dashboard server. Optional for public repos, but
# without it GitHub allows 60 requests/hour, so auto-refresh is disabled.
# A fine-grained token with read access to the repository is enough.
GITHUB_TOKEN=

# GitHub Enterprise Server API base URL (defaults to https://api.github.com).
# GITHUB_API_URL=

# Account that authors the review comment. Comments by anyone else are ignored.
# JEV_REVIEW_COMMENT_AUTHOR=github-actions[bot]
